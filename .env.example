# Neon pooled connection for the app, direct connection for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# Vercel sets Authorization: Bearer $CRON_SECRET when invoking its cron.
CRON_SECRET="replace-with-a-long-random-secret"
# Agent/service token for POST /api/admin/import and GET /api/admin/status.
INGEST_API_KEY="replace-with-another-long-random-secret"

# Public Australian tournament search; defaults to Queensland. Searches the
# past 365 days and next 90 days, up to five pages per run. No Meta token needed.
TOURNAMENT_DISCOVERY_QUERY="Queensland"

# Optional. Requires Meta Page Public Content Access (or page ownership and the
# appropriate page read permissions) for all configured pages.
FACEBOOK_DISCOVERY_ENABLED="false"
FACEBOOK_PAGE_ACCESS_TOKEN=""

# Optional Neon Auth human-admin session. ADMIN_EMAIL is the only account
# allowed to call admin endpoints through a browser session.
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""
ADMIN_EMAIL=""
